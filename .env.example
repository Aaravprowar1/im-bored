# Copy to .env.local and fill in. Never commit real values.
# Every variable is optional: without Supabase the site runs in development
# mode with the built-in activity list and no accounts.

# Public site URL (used for auth redirects, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on /contact. Leave empty to show a "not configured" notice.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Used for account deletion and the seed script.
# Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
